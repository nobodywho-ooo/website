<div class="blog-main lab">
  <div class="blog-wrap">
    <h1 class="blog-title">Lab</h1>
    <p class="blog-intro">Try AI locally in minutes, see our demos and what others are building.</p>
    <section class="lab-section" aria-labelledby="starters">
      <div class="lab-head">
        <h2 class="lab-title" id="starters">Starter examples</h2>
        <p class="lab-sub">Quickly try our inference engine and see how to implement on-device AI.</p>
      </div>
      <ul class="lab-boxes">
        {%- for s in starters %}
          <li>
            <a href="https://github.com/{{ s.repo }}" target="_blank" rel="noopener">
              {% svg s.icon, "lab-icon" %}
              <b>{{ s.name }}</b>
              <span>{{ s.repo }}</span>
            </a>
          </li>
        {%- endfor %}
      </ul>
    </section>
    <section class="lab-section" aria-labelledby="community">
      <div class="lab-head">
        <h2 class="lab-title" id="community">Community projects</h2>
        <p class="lab-sub">See what others are building, get inspired.</p>
      </div>
      <ul class="lab-rows">
        {%- for p in community %}
          <li>
            <a href="{{ p.url }}" target="_blank" rel="noopener">
              <h3>{{ p.title }}</h3>
              <p>{{ p.text }}</p>
              <span class="lab-host">{{ p.host }}</span>
            </a>
          </li>
        {%- endfor %}
      </ul>
    </section>
  </div>
</div>