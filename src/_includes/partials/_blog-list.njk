{# Shared listing for /posts/ and category pages. #}
<section class="blog-wrap">
    <h1 class="blog-title">{% if selectedCategory == 'all' %}Blog{% else %}{{ selectedCategory }}{% endif %}</h1>
    <p class="blog-intro">Updates and technical notes from the NobodyWho team.</p>
    <nav class="blog-categories" aria-label="Blog categories">
        <a href="/posts/"{% if selectedCategory == 'all' %} aria-current="page"{% endif %}>All categories</a>
        {% for category in blogCategories %}<a href="/posts/category/{{ category | blogSlug }}/"{% if selectedCategory == category %} aria-current="page"{% endif %}>{{ category }}</a>{% endfor %}
    </nav>
    <div class="blog-posts">
        {% if postsToShow.length %}
            {% for post in postsToShow %}
            <article class="blog-post">
                <div><time datetime="{{ post.date | dateISO }}">{{ post.date | dateFormating }}</time><span class="blog-post-cats">{% for category in post.data.categories %}{{ category }}{% if not loop.last %} / {% endif %}{% endfor %}</span></div>
                <div><a href="{{ post.url }}"><h2>{{ post.data.title }}</h2></a><p>{{ post.data.description }}</p></div>
            </article>
            {% endfor %}
        {% else %}<p class="blog-intro">No articles in this category yet.</p>{% endif %}
    </div>
    {% if pageHrefs and pageHrefs.length > 1 %}
    <nav class="blog-pagination" aria-label="Pagination">
        {% if prevHref %}<a href="{{ prevHref }}" rel="prev" aria-label="Previous page">←</a>{% endif %}
        {% for href in pageHrefs %}{% if loop.index0 == currentPage %}<span aria-current="page">{{ loop.index }}</span>{% else %}<a href="{{ href }}" aria-label="Page {{ loop.index }}">{{ loop.index }}</a>{% endif %}{% endfor %}
        {% if nextHref %}<a href="{{ nextHref }}" rel="next" aria-label="Next page">→</a>{% endif %}
    </nav>
    {% endif %}
</section>
