{% if blogTheme %}
<footer class="blog-footer">
    <span>© NobodyWho</span>
    <nav aria-label="Footer links"><a href="/#pricing">Pricing</a><a href="/posts/">Blog</a><a href="https://docs.nobodywho.ai/">Docs</a><a href="/privacy/">Privacy</a></nav>
    <div class="blog-social">
        <a href="{{ site.github_url }}" aria-label="GitHub"><span class="social-icon icon-github" aria-hidden="true"></span></a>
        <a href="https://www.linkedin.com/company/nobodywho/" aria-label="LinkedIn"><span class="social-icon icon-linkedin" aria-hidden="true"></span></a>
        <a href="https://x.com/nobodywho_ai" aria-label="X"><span class="social-icon icon-x" aria-hidden="true"></span></a>
        <a href="https://bsky.app/profile/nobodywhooo.bsky.social" aria-label="Bluesky"><span class="social-icon icon-bluesky" aria-hidden="true"></span></a>
        <a href="https://huggingface.co/NobodyWho" aria-label="Hugging Face"><span class="social-icon icon-huggingface" aria-hidden="true"></span></a>
    </div>
</footer>
{% else %}
<footer>
    <div class="mx-auto max-w-7xl overflow-hidden px-6 py-20 sm:py-24 lg:px-8">
        <nav aria-label="Footer" class="-mb-6 flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm/6">
            <a href="/#product" class="text-neutral-500 hover:text-primary dark:text-neutral-400">Product</a>
            <a href="/#pricing" class="text-neutral-500 hover:text-primary dark:text-neutral-400">Pricing</a>
            <a href="/posts/" class="text-neutral-500 hover:text-primary dark:text-neutral-400">Blog</a>
            <a href="/#contact" class="text-neutral-500 hover:text-primary dark:text-neutral-400">Contact</a>
            <a
                href="https://docs.nobodywho.ai/"
                aria-label="Documentation"
                class="text-neutral-500 hover:text-primary dark:text-neutral-400 dark:hover:text-white">Docs</a>
            <a href="/privacy/" aria-label="Privacy Policy" class="{% if page.url == '/privacy/' %}text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-primary dark:text-neutral-400 dark:hover:text-white{% endif %}">Privacy</a>
        </nav>
        <div class="mt-16 flex flex-wrap justify-center gap-x-10 gap-y-4">
            {% for item in site.footer %}
                <a href="{{ item.url }}" target="_blank" class="text-neutral-600 hover:text-primary dark:text-neutral-400 dark:hover:text-white">
                    <span class="sr-only">{{ item.name }}</span>
                    {% svg item.icon, "size-6" %}
                </a>
            {% endfor %}
        </div>
        <a href="/">
            <p class="mt-10 text-center text-sm/6 text-neutral-600 hover:text-primary dark:text-neutral-400 dark:hover:text-white">
            NobodyWho</p>
        </a>
    </div>
</footer>
{% endif %}