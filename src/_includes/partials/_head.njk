<head>
  <meta charset="UTF-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  {% if blogTheme %}
  <meta name="color-scheme" content="light"/>
  <meta name="theme-color" content="#e9e2d8"/>
  {% else %}
  <meta name="color-scheme" content="light dark"/>
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff"/>
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717"/>
  {% endif %}
  <!-- https://favicon.io/ -->
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/favicon/apple-touch-icon.png' | url }}"/>
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon/favicon-32x32.png' | url }}"/>
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon/favicon-16x16.png' | url }}"/>
  <link rel="manifest" href="{{ '/assets/favicon/site.webmanifest' | url }}"/>
  {% if blogTheme %}
  <link rel="preload" href="{{ '/assets/fonts/InterTight-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin/>
  <link rel="stylesheet" href="{{ '/assets/css/brand-fonts.css' | url }}"/>
  <link rel="stylesheet" href="{{ '/assets/css/blog-refresh.css' | url }}"/>
  {% else %}
  <link rel="preload" href="{{ '/assets/css/tailwind-dist.css' | url }}" as="style"/>
  <link rel="preload" href="{{ '/assets/fonts/Satoshi-Medium.woff2' | url }}" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="{{ '/assets/fonts/dm-sans-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin/>
  <link rel="stylesheet" href="{{ '/assets/css/tailwind-dist.css' | url }}">
  {% endif %}
  <title>{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta
    name="description"
    content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}"/>
  <meta name="google-site-verification" content="-IlFRGOO6ocIV9ChWcEJ9BvxVVa-Ku1WsuN9gZWbEZQ" />
  {% if noindex %}<meta name="robots" content="noindex, follow"/>{% endif %}

  {% set pageTitle %}{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}{% endset %}
  {% set pageDescription %}{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}{% endset %}
  {% set pageUrl %}{{ page.url | absoluteUrl(site.url) }}{% endset %}
  {% set pageImage %}{% if image %}{{ image | absoluteUrl(site.url) }}{% else %}{{ '/assets/favicon/android-chrome-512x512.png' | absoluteUrl(site.url) }}{% endif %}{% endset %}

  <link rel="canonical" href="{{ pageUrl }}"/>
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Blog" href="{{ '/feed.xml' | url }}"/>

  <!-- Open Graph -->
  <meta property="og:type" content="{% if layout == 'article' %}article{% else %}website{% endif %}"/>
  <meta property="og:title" content="{{ pageTitle }}"/>
  <meta property="og:description" content="{{ pageDescription }}"/>
  <meta property="og:url" content="{{ pageUrl }}"/>
  <meta property="og:image" content="{{ pageImage }}"/>
  <meta property="og:site_name" content="{{ site.name }}"/>
  {% if layout == 'article' and author %}<meta property="article:author" content="{{ author }}"/>{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="{{ pageTitle }}"/>
  <meta name="twitter:description" content="{{ pageDescription }}"/>
  <meta name="twitter:image" content="{{ pageImage }}"/>

  <!-- Structured data (JSON-LD) -->
  {% set orgLogo %}{{ '/assets/favicon/android-chrome-512x512.png' | absoluteUrl(site.url) }}{% endset %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ (site.url ~ '/#organization') | jsonLd | safe }},
    "name": {{ site.name | jsonLd | safe }},
    "url": {{ site.url | jsonLd | safe }},
    "logo": { "@type": "ImageObject", "url": {{ orgLogo | jsonLd | safe }} },
    "description": {{ site.description | jsonLd | safe }},
    "sameAs": {{ site.footer | socialUrls | jsonLd | safe }}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ (site.url ~ '/#website') | jsonLd | safe }},
    "name": {{ site.name | jsonLd | safe }},
    "url": {{ site.url | jsonLd | safe }},
    "description": {{ site.description | jsonLd | safe }},
    "publisher": { "@id": {{ (site.url ~ '/#organization') | jsonLd | safe }} }
  }
  </script>
  {% if layout == "article" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | jsonLd | safe }},
    "description": {{ (description or site.description) | jsonLd | safe }},
    "image": {{ pageImage | jsonLd | safe }},
    "datePublished": {{ date | dateISO | jsonLd | safe }},
    "dateModified": {{ (updated or date) | dateISO | jsonLd | safe }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ pageUrl }}"
    },
    "author": {
      "@type": {% if author and author != site.name %}"Person"{% else %}"Organization"{% endif %},
      "name": {{ (author or site.author) | jsonLd | safe }}
    },
    "publisher": { "@id": {{ (site.url ~ '/#organization') | jsonLd | safe }} }{% if categories %},
    "keywords": {{ categories | jsonLd | safe }}{% endif %}
  }
  </script>
  {% endif %}

    <!-- Plausible -->
  <script async src="https://plausible.io/js/pa-WbhH9LN_2_GA3hpDQZAkt.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>